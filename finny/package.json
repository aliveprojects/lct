{
  "name": "finni",
  "version": "1.0.0",
  "private": true,
  "description": "Финни — офлайн-приложение для детей 7–11 лет: виртуальный питомец и первые шаги в финансовой грамотности",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "docs": "node scripts/gen-docs.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "cap:sync": "npm run build && cap sync android",
    "release": "bash scripts/build-release.sh",
    "contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource-variable/rubik": "^5.3.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "sharp": "^0.35.4",
    "typescript": "~5.9",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
